# Exemplo de configuração local. Copie para .env e preencha os valores.
# O arquivo .env é ignorado pelo Git; nunca versiona chaves ou segredos reais.

# Backend da conversa: mock (demonstração) ou real (RAG-01).
CHAT_BACKEND=real

# RAG-04 — geração Gemini (somente backend).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=0

# Orçamento e memória do agente.
RAG_MAX_PROMPT_TOKENS=8192
RAG_MAX_HISTORY_MESSAGES=20
RAG_AGENT_RECURSION_LIMIT=8

# Sessão da conversa. Use 1 atrás de HTTPS.
RAG01_COOKIE_SECURE=0

# Origens explícitas do frontend separado (Squad-13-frontend).
# O proxy do Vite evita CORS no navegador; ajuste se usar outra porta/origem.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Laboratório GLPI — preencha com os valores do seu ambiente.
GLPI_BASE_URL_V1=http://localhost:8080/api.php
GLPI_BASE_URL_V2=http://localhost:8080/api.php/v2
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
APP_TIMEZONE=America/Fortaleza
